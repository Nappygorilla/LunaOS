<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/polkit-1/policyconfig.dtd">
<policyconfig>
  <vendor>LunaOS Project</vendor>
  <vendor_url>https://github.com/Nappygorilla/LunaOS</vendor_url>
  <action id="org.lunaos.setup.create-first-user">
    <description>Create the first personal LunaOS account</description>
    <message>Allow LunaOS first-run setup to create one personal account</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>yes</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/lunaos/lunaos-setup-user-helper</annotate>
  </action>
</policyconfig>
